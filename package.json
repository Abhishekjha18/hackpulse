{
  "name": "hackpulse",
  "private": true,
  "description": "Self-hosted, API-first hackathon submission-and-judging portal.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "dev:api": "pnpm --filter @hackpulse/api run start:dev",
    "dev:web": "pnpm --filter @hackpulse/web run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint -- --fix",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dup-check": "jscpd apps/api/src apps/web/app apps/web/lib apps/web/components packages/shared/src"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jscpd": "^5.3.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  }
}
