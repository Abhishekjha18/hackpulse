# Copy to .env and adjust for local development.
# docker-compose.yml injects the equivalents directly into the api/worker containers.

# Postgres (matches docker-compose.yml's postgres service).
# DATABASE_URL is the restricted runtime role the api/worker connect as
# (it cannot UPDATE/DELETE audit_log_entries — ADR-009). Migrations run as
# the schema-owning role via MIGRATION_DATABASE_URL instead. Both roles are
# created by drizzle/0001_restrict_audit_log_grants.sql on first migrate.
DATABASE_URL=postgres://hackpulse_app:hackpulse_app_dev_only@localhost:5433/hackpulse
MIGRATION_DATABASE_URL=postgres://hackpulse:hackpulse_dev_only@localhost:5433/hackpulse

# Redis (matches docker-compose.yml's redis service)
REDIS_URL=redis://localhost:6379

# api
PORT=3001
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me
BETTER_AUTH_URL=http://localhost:3001
# Used to build the QR-code verify URL embedded in judge certificates.
PUBLIC_API_URL=http://localhost:3001
# The browser's actual page origin, checked by Better Auth against the
# Origin header on every state-changing request — even though the browser
# only ever talks to web, which proxies server-to-server to this API.
WEB_ORIGIN=http://localhost:3000
# Where rendered certificate PDFs are written (a local volume, not object
# storage — NFR-OPS-01, no external service dependency).
CERTIFICATES_DIR=./data/certificates

# web
HACKPULSE_API_URL=http://localhost:3001
