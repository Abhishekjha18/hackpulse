# Copy to .env and adjust for local development.
# docker-compose.yml injects the equivalents directly into the api/worker containers.

# Postgres (matches docker-compose.yml's postgres service).
DATABASE_URL=postgres://hackpulse:hackpulse_dev_only@localhost:5432/hackpulse

# Redis (matches docker-compose.yml's redis service)
REDIS_URL=redis://localhost:6379

# api
PORT=3001
