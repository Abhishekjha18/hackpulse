{
  "name": "@hackpulse/api",
  "version": "0.1.0",
  "private": true,
  "description": "HackPulse API — owns all business logic and authorization. Every UI action is a documented call against this service.",
  "scripts": {
    "prebuild": "pnpm --filter @hackpulse/shared run build",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "pnpm --filter @hackpulse/shared run build",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "pretypecheck": "pnpm --filter @hackpulse/shared run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @hackpulse/shared run build",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "preopenapi:export": "nest build",
    "openapi:export": "node dist/openapi/export.js"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@hackpulse/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-fastify": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "better-auth": "^1.7.4",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/jest": "^29.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "js-yaml": "^5.4.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
